# Copy this file to .env and fill in real values. .env itself is
# gitignored -- never commit real keys.
#
# Only DEEPSEEK_API_KEY is required for the cheapest full pipeline run
# (llm_sector_matcher.py's default provider). Swap to ANTHROPIC_API_KEY
# with --provider anthropic if you'd rather use Claude for classification.
#
# GEMINI_API_KEY powers ercot_large_load_tracker.py's vision fallback
# (reading a chart-only figure off a report page image) -- free to obtain
# from Google AI Studio, no budget needed, unlike Anthropic's. DeepSeek
# was considered for this first but ruled out: their public API has no
# image/vision input at all, confirmed from DeepSeek's own docs.

DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
STEEL_API_KEY=
